<ui:FluentWindow x:Class="Login38.App.Views.HelperWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:helper="clr-namespace:Login38.App.ViewModels.Helper"
                 xmlns:lui="clr-namespace:Login38.Ui;assembly=Login38.Ui"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 d:DataContext="{d:DesignInstance Type=helper:HelperViewModel}"
                 mc:Ignorable="d"
                 Style="{StaticResource Window.Shell}"
                 WindowStartupLocation="CenterOwner"
                 Title="輔助設定"
                 Width="960"
                 Height="680"
                 MinWidth="860"
                 MinHeight="600">

    <ui:FluentWindow.Resources>
        <!--
            The library's controls, adopted.

            The theme keeps these keyed rather than implicit: a style keyed on a type that
            derives from the style keyed on the same type is a style that asks for itself,
            and what comes back has no template. Turning them back into implicit styles
            here works because a window's own Resources is a different dictionary, so the
            lookup finds the theme's entry rather than the one being written.
        -->
        <Style TargetType="ui:TitleBar" BasedOn="{StaticResource Library.TitleBar}" />
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource Library.TextBox}" />
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource Library.NumberBox}" />
        <Style TargetType="ui:InfoBar" BasedOn="{StaticResource Library.InfoBar}" />
        <Style TargetType="ui:ContentDialog" BasedOn="{StaticResource Library.ContentDialog}" />
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource Library.Card}" />
        <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource Library.ProgressRing}" />

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Thickness x:Key="RowSpacing">0,0,0,8</Thickness>

        <!--
            A label sitting to the left of the control it names. The width of the number
            fields is the theme's business now; this is only the gap beside them.

            Declared up here with the other shared pieces, and before the templates that use
            it, because a StaticResource cannot look forwards. It sat below them and the
            dialog that wanted it threw on the way open — the templates further down the
            file are only ever applied by the page around them, which is parsed later still,
            so they never noticed.
        -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- A button that opens a window rather than doing something. The ellipsis is the
             convention that says so, and the width keeps a row of them even. -->
        <Style x:Key="OpensADialog" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <!-- Said here rather than left to the appearance. Secondary paints its label in
                 the library's own grey, which on this palette reads as disabled — four
                 buttons that all look switched off, on a page where being switched off is a
                 real state that other controls show. Primary ink for the label, accent for
                 the icon, and the accent brightens under the pointer so the row answers
                 back. -->
            <Setter Property="Foreground" Value="{StaticResource Ink.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line.Subtle}" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent.Bright}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Deep}" />
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Ink.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            The bodies of the hunt's dialogs.

            Kept as templates rather than as more of the page, because that is the whole
            point of moving them: the page is what is looked at every session, and these are
            what is set once. A template also keeps the binding paths exactly as they were
            when this was all one page — the dialog is shown against the same view model.
        -->
        <DataTemplate x:Key="Hunt.Filters">
            <Grid Width="620" Height="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.Section}" DockPanel.Dock="Top"
                               Text="排除" Margin="0,0,0,6" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Margin="0,0,6,0"
                                    PlaceholderText="怪物名稱"
                                    Text="{Binding Blacklist.Candidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Margin="0,0,6,0" Appearance="Secondary"
                                   Content="新增" Command="{Binding Blacklist.AddCommand}" />
                        <ui:Button Grid.Column="2" Appearance="Secondary"
                                   Content="移除" Command="{Binding Blacklist.RemoveCommand}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Blacklist.Items}"
                             SelectedItem="{Binding Blacklist.Selected, Mode=TwoWay}" />
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Section}" DockPanel.Dock="Top"
                               Text="只打(空白 = 全打)" Margin="0,0,0,6" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Margin="0,0,6,0"
                                    PlaceholderText="怪物名稱"
                                    Text="{Binding Whitelist.Candidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Margin="0,0,6,0" Appearance="Secondary"
                                   Content="新增" Command="{Binding Whitelist.AddCommand}" />
                        <ui:Button Grid.Column="2" Appearance="Secondary"
                                   Content="移除" Command="{Binding Whitelist.RemoveCommand}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Whitelist.Items}"
                             SelectedItem="{Binding Whitelist.Selected, Mode=TwoWay}" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Hunt.Stall">
            <StackPanel Width="460">
                <TextBlock Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="怪物站在走不到的地方時,角色會停在原地。這兩個數字決定多久算是停住,以及停住後把牠擱置多久。" />

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="停住幾秒放棄"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1" Minimum="1" Maximum="120" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding StallSeconds, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="擱置幾秒再試"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1" Minimum="1" Maximum="600" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding IgnoreSeconds, Mode=TwoWay}" />
                </Grid>

                <TextBlock Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,24,0,12"
                           Text="換點不是逃跑:這一區打完了或走不過去就換個地方,繼續掛。卡住的判斷是沒移動而且沒有任何怪在掉血,所以遠程站著射不算;建議 30 秒以上。填 0 表示不看那一項。" />

                <CheckBox Content="卡住或沒怪時換點"
                          Margin="{StaticResource RowSpacing}"
                          IsChecked="{Binding RelocateEnabled, Mode=TwoWay}" />

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="原地不動"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1" Margin="0,0,8,0"
                                  Minimum="0" Maximum="600" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding RelocateStuckSeconds, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="秒"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="附近沒怪"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1" Margin="0,0,8,0"
                                  Minimum="0" Maximum="600" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding RelocateBarrenSeconds, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="秒"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="卷軸"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              IsEditable="True"
                              Text="{Binding RelocateItem, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              ItemsSource="{Binding DataContext.BagChoices, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>

            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Hunt.Skills">
            <StackPanel Width="620">
                <TextBlock Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="由上往下輪流,一次出手用掉一格,到底再回到第一格。普攻那一格不放技能,它換到的是間隔——中間想隔幾下就放幾格普攻。輪到的技能還在冷卻、魔力不夠或不在射程,就跳過,下一輪再回來。射程與是不是攻擊魔法都讀客戶端自己的魔法書。" />

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="這一格" Width="88"
                               Style="{StaticResource Text.Caption}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="魔法名稱"
                               Style="{StaticResource Text.Caption}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Text="間隔(秒)" Width="86"
                               Style="{StaticResource Text.Caption}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="4" Text="魔力 ≥ %" Width="86"
                               Style="{StaticResource Text.Caption}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Skills}"
                              >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type helper:HuntSkillRowViewModel}">
                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Margin="0,0,4,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                <ComboBox Grid.Column="1"
                                          Margin="0,0,8,0"
                                          Width="88"
                                          SelectedIndex="{Binding StepIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="技能" />
                                    <ComboBoxItem Content="普攻" />
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                          Margin="0,0,8,0"
                                          IsEditable="True"
                                          IsEnabled="{Binding IsSkill}"
                                          Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.SkillChoices, RelativeSource={RelativeSource AncestorType=Window}}" />

                                <ui:NumberBox Grid.Column="3"
                                              Margin="0,0,8,0"
                                              Width="86"
                                              Minimum="0"
                                              Maximum="600"
                                              MaxDecimalPlaces="1"
                                              IsEnabled="{Binding IsSkill}"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding IntervalSeconds, Mode=TwoWay}" />

                                <ui:NumberBox Grid.Column="4"
                                              Width="86"
                                              Minimum="0"
                                              Maximum="100"
                                              MaxDecimalPlaces="0"
                                              IsEnabled="{Binding IsSkill}"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding ManaAtLeast, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Hunt.Scrolls">
            <StackPanel Width="460">
                <TextBlock Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="血量掉到設定值以下讀一張,讀完會把自動打怪關掉,要等血量回到設定值以上才會再讀第二張。落點由角色身上的傳送控制戒指和伺服器決定,這裡管不到。" />

                <CheckBox Content="血量過低時讀卷軸"
                          Margin="{StaticResource RowSpacing}"
                          IsChecked="{Binding EscapeEnabled, Mode=TwoWay}" />

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="血量低於"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1" Margin="0,0,8,0"
                                  Minimum="1" Maximum="99" MaxDecimalPlaces="0"
                                  ClearButtonEnabled="False"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding EscapeHitPoints, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="%"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="卷軸"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              IsEditable="True"
                              Text="{Binding EscapeItem, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              ItemsSource="{Binding DataContext.BagChoices, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>


            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- The window paints its own background rather than leaving it to the window's
         Background property. The control library writes that one as a local value while
         the window loads, which beats anything a style can say, and what came out was the
         library's grey and not this palette's black. Painted here it is the palette's, and
         it stays the palette's whatever the library decides. -->
    <Grid Background="{StaticResource Surface.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="44">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="3"
                            Height="16"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Accent}" />
                    <TextBlock Style="{StaticResource Text.Strong}"
                               VerticalAlignment="Center"
                               Text="輔助設定" />
                    <TextBlock Style="{StaticResource Text.Label}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="遊戲中 Home 收合此視窗 · Insert 開關輔助" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Pages down the side rather than tabs across the top: seven of them is past
             what a strip can label without truncating, and the list stays readable while
             a page is open. -->
        <TabControl Grid.Row="1" Margin="0,4,0,0">

            <!-- ==================== Potions ==================== -->
            <TabItem Header="喝水"
                     lui:Rail.Icon="{ui:SymbolIcon Drop24}"
                     lui:Rail.Note="血量與魔力">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <lui:Section Header="喝水"
                                     Note="血量低於設定值時喝下指定的道具。由上往下依序判斷,符合的第一條生效。">
                            <ItemsControl ItemsSource="{Binding Potions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type helper:PotionRowViewModel}">
                                    <Grid Margin="{StaticResource RowSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                        <ui:NumberBox Grid.Column="1"
                                                      Margin="0,0,8,0"
                                                      Minimum="0"
                                                      Maximum="{Binding Ceiling}"
                                                      MaxDecimalPlaces="0"
                                                      ClearButtonEnabled="False"
                                                      ValidationMode="InvalidInputOverwritten"
                                                      Value="{Binding Threshold, Mode=TwoWay}" />

                                        <ComboBox Grid.Column="2"
                                                  IsEditable="True"
                                                  Text="{Binding Item, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  ItemsSource="{Binding DataContext.HealingChoices, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </lui:Section>

                        <lui:Section Header="洗魔(以血換魔)"
                                     Note="會扣血,兩個條件都成立才執行。這兩格一律以百分比判斷。">
                        <Grid DataContext="{Binding Mana}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />

                            <TextBlock Grid.Column="1" Text="血量 ≥" Style="{StaticResource FieldLabel}" />

                            <ui:NumberBox Grid.Column="2"
                                          Margin="0,0,8,0"
                                          Minimum="0"
                                          Maximum="100"
                                          MaxDecimalPlaces="0"
                                          ClearButtonEnabled="False"
                                          ValidationMode="InvalidInputOverwritten"
                                          Value="{Binding HitPointsAtLeast, Mode=TwoWay}" />

                            <TextBlock Grid.Column="3" Text="魔力 ≤" Style="{StaticResource FieldLabel}" />

                            <ui:NumberBox Grid.Column="4"
                                          Margin="0,0,8,0"
                                          Minimum="0"
                                          Maximum="100"
                                          MaxDecimalPlaces="0"
                                          ClearButtonEnabled="False"
                                          ValidationMode="InvalidInputOverwritten"
                                          Value="{Binding ManaAtMost, Mode=TwoWay}" />

                            <ComboBox Grid.Column="5"
                                      IsEditable="True"
                                      Text="{Binding Item, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding DataContext.ManaChoices, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                        </lui:Section>

                        <lui:Section Header="判讀方式" Note="這兩項一起決定上面的數字怎麼讀,以及清單裡出現什麼。">
                            <StackPanel>
                                <CheckBox Content="以百分比判斷上面的數值"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding UsePercent, Mode=TwoWay}" />

                                <CheckBox Content="同時列出背包裡的道具"
                                          IsChecked="{Binding ShowInventory, Mode=TwoWay}" />
                            </StackPanel>
                        </lui:Section>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Buffs ==================== -->
            <TabItem Header="輔助"
                     lui:Rail.Icon="{ui:SymbolIcon Sparkle24}"
                     lui:Rail.Note="自動維持狀態">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The switch for the whole page, given its own strip so that it does
                         not read as one more item in the list underneath it. -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,16"
                            Padding="12,10"
                            Background="{StaticResource Surface.Raised}"
                            BorderBrush="{StaticResource Line.Subtle}"
                            BorderThickness="1">
                        <CheckBox Content="角色在世界中時自動維持下列狀態"
                                  IsChecked="{Binding HelperEnabled, Mode=TwoWay}" />
                    </Border>

                    <Grid Grid.Row="1" IsEnabled="{Binding HelperEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: everything that could be maintained. -->
                        <lui:Section Grid.Column="0"
                                     Margin="0,0,14,0"
                                     Header="可選項目"
                                     Note="從這裡挑,加到右邊。">
                            <DockPanel>
                                <!-- A strip the same height as the one under the other
                                     list, so the two lists end on the same line. It says
                                     how many there are, which is the only thing worth
                                     saying here and better than a blank spacer. -->
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource Text.Caption}"
                                           Height="32"
                                           Margin="2,8,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding StateChoices.Count, StringFormat=共 {0} 項}" />

                                <ListBox ItemsSource="{Binding StateChoices}"
                                         SelectedItem="{Binding Buffs.Candidate, Mode=TwoWay}" />
                            </DockPanel>
                        </lui:Section>

                        <!-- Middle: across, and only across. Moving a row up or down is a
                             different job from moving it between the two lists, and a
                             single column of four buttons said they were the same job. -->
                        <StackPanel Grid.Column="1"
                                    Width="104"
                                    VerticalAlignment="Center">
                            <ui:Button Content="加入 →"
                                       Style="{StaticResource Button.Column}"
                                       Command="{Binding Buffs.AddCommand}" />
                            <ui:Button Content="← 移除"
                                       Style="{StaticResource Button.Column}"
                                       Command="{Binding Buffs.RemoveCommand}" />
                        </StackPanel>

                        <!-- Right: what is maintained, in the order it is maintained. -->
                        <lui:Section Grid.Column="2"
                                     Margin="14,0,0,0"
                                     Header="已選"
                                     Note="由上往下依序施放。順序會影響先補到什麼。">
                            <DockPanel>
                                <!-- Under the list rather than beside it: these two act on
                                     the row selected in this list and nowhere else. -->
                                <StackPanel DockPanel.Dock="Bottom"
                                            Height="32"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                    <ui:Button Content="上移"
                                               Appearance="Secondary"
                                               Width="76"
                                               Margin="0,0,8,0"
                                               HorizontalContentAlignment="Center"
                                               Command="{Binding Buffs.MoveUpCommand}" />
                                    <ui:Button Content="下移"
                                               Appearance="Secondary"
                                               Width="76"
                                               HorizontalContentAlignment="Center"
                                               Command="{Binding Buffs.MoveDownCommand}" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Buffs.Items}"
                                         SelectedItem="{Binding Buffs.Selected, Mode=TwoWay}" />
                            </DockPanel>
                        </lui:Section>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== Hunt ==================== -->
            <TabItem Header="狩獵"
                     Visibility="{Binding HuntingOffered, Converter={StaticResource BooleanToVisibility}}"
                     lui:Rail.Icon="{ui:SymbolIcon TargetArrow24}"
                     lui:Rail.Note="自動狩獵">
                <StackPanel Margin="12" DataContext="{Binding Hunt}">
                    <lui:Section Header="自動狩獵"
                                 Note="選目標、算路線、繞開牆和擋路的怪都在這裡做;客戶端只負責把腳步和攻擊動作演出來。">
                        <StackPanel>
                            <CheckBox Content="自動找怪並攻擊"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />

                            <CheckBox Content="被攻擊時改打真正打我的那隻"
                                      Margin="{StaticResource RowSpacing}"
                                      ToolTip="讀客戶端自己記的「誰在攻擊我」名單,不是猜最近的那隻。"
                                      IsChecked="{Binding Retaliate, Mode=TwoWay}" />

                            <Grid>
                                <!-- The field column takes its width from the control
                                     rather than being given one. The theme sets a number
                                     box a minimum wide enough for its largest value, and a
                                     column narrower than that does not shrink the box — it
                                     lets the box overrun and sit on what is beside it. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="搜尋範圍"
                                           Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" />

                                <ui:NumberBox Grid.Column="1"
                                              Margin="0,0,8,0"
                                              Minimum="1"
                                              Maximum="200"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding RangeSteps, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2"
                                           Text="步,超過這個距離的怪不找"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="遠程站位"
                                           Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" />

                                <ui:NumberBox Grid.Column="1"
                                              Margin="0,0,8,0"
                                              Minimum="1"
                                              Maximum="30"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding StandoffTiles, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2"
                                           Text="格,同時決定走多近和算不算在射程內"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </lui:Section>

                    <lui:Section Header="細部設定"
                                 Note="設一次就好的東西各自開窗,不擠在這一頁。">
                        <WrapPanel>
                            <ui:Button Style="{StaticResource OpensADialog}"
                                       Icon="{ui:SymbolIcon PersonProhibited24}"
                                       Content="怪物過濾…"
                                       Click="OpenHuntFilters" />

                            <ui:Button Style="{StaticResource OpensADialog}"
                                       Icon="{ui:SymbolIcon Timer24}"
                                       Content="卡住處理…"
                                       Click="OpenHuntStall" />

                            <ui:Button Style="{StaticResource OpensADialog}"
                                       Icon="{ui:SymbolIcon Flash24}"
                                       Content="攻擊順序…"
                                       Click="OpenHuntSkills" />

                            <ui:Button Style="{StaticResource OpensADialog}"
                                       Icon="{ui:SymbolIcon ArrowExit24}"
                                       Content="逃跑卷軸…"
                                       Click="OpenHuntScrolls" />
                        </WrapPanel>
                    </lui:Section>
                </StackPanel>
            </TabItem>

            <TabItem Header="狀態"
                     lui:Rail.Icon="{ui:SymbolIcon Person24}"
                     lui:Rail.Note="角色與功能鍵">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <lui:Section Header="角色" Note="在世界中時持續照看,不必按任何鍵。">
                            <StackPanel>
                                <CheckBox Content="顯示經驗值"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding ShowExperience, Mode=TwoWay}" />

                                <CheckBox Content="磨刀石修武器"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding KeepWeaponSharp, Mode=TwoWay}" />

                                <CheckBox Content="飢餓時自動吃肉"
                                          IsChecked="{Binding EatWhenHungry, Mode=TwoWay}" />
                            </StackPanel>
                        </lui:Section>

                        <lui:Section Header="道具規則" Note="左邊勾選啟用,右邊選要用的道具。">
                            <StackPanel>
                        <Grid Margin="{StaticResource RowSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Content="變身"
                                      IsChecked="{Binding TransformEnabled, Mode=TwoWay}" />

                            <ComboBox Grid.Column="1"
                                      Margin="0,0,8,0"
                                      IsEditable="True"
                                      Text="{Binding TransformItem, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding TransformItemChoices}" />

                            <ComboBox Grid.Column="2"
                                      IsEditable="True"
                                      Text="{Binding TransformCondition, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding TransformationChoices}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Content="解毒"
                                      IsChecked="{Binding AntidoteEnabled, Mode=TwoWay}" />

                            <ComboBox Grid.Column="1"
                                      IsEditable="True"
                                      Text="{Binding AntidoteItem, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding AntidoteChoices}" />
                        </Grid>
                            </StackPanel>
                        </lui:Section>

                        <lui:Section Header="功能鍵" Note="遊戲視窗在最前面時,按下該鍵就執行。這幾個鍵不會傳給客戶端。">
                        <ItemsControl ItemsSource="{Binding Macros}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type helper:MacroViewModel}">
                                    <Grid Margin="{StaticResource RowSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                        <TextBlock Grid.Column="1"
                                                      Text="{Binding Label}"
                                                      Style="{StaticResource FieldLabel}" />

                                        <ui:TextBox Grid.Column="2"
                                                    Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="0_加速術/ME" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </lui:Section>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Discard ==================== -->
            <TabItem Header="刪物"
                     lui:Rail.Icon="{ui:SymbolIcon Delete24}"
                     lui:Rail.Note="撿到就處理">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="3"
                              Margin="0,0,0,10"
                              Content="撿到清單內的道具時自動處理"
                              IsChecked="{Binding DeleteEnabled, Mode=TwoWay}" />

                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.Section}" DockPanel.Dock="Top"
                                   Text="刪除清單"
                                   Margin="0,0,0,6" />

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Margin="0,0,6,0"
                                      IsEditable="True"
                                      Text="{Binding Delete.Candidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding BagChoices}" />

                            <ui:Button Grid.Column="1"
                                       Margin="0,0,6,0"
                                       Appearance="Secondary"
                                       Content="新增"
                                       Command="{Binding Delete.AddCommand}" />

                            <ui:Button Grid.Column="2"
                                       Appearance="Secondary"
                                       Content="移除"
                                       Command="{Binding Delete.RemoveCommand}" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Delete.Items}"
                                 SelectedItem="{Binding Delete.Selected, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.Section}" DockPanel.Dock="Top"
                                   Text="溶解清單"
                                   Margin="0,0,0,6" />

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Margin="0,0,6,0"
                                      IsEditable="True"
                                      Text="{Binding Dissolve.Candidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding BagChoices}" />

                            <ui:Button Grid.Column="1"
                                       Margin="0,0,6,0"
                                       Appearance="Secondary"
                                       Content="新增"
                                       Command="{Binding Dissolve.AddCommand}" />

                            <ui:Button Grid.Column="2"
                                       Appearance="Secondary"
                                       Content="移除"
                                       Command="{Binding Dissolve.RemoveCommand}" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Dissolve.Items}"
                                 SelectedItem="{Binding Dissolve.Selected, Mode=TwoWay}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ==================== Shout ==================== -->
            <TabItem Header="喊話"
                     lui:Rail.Icon="{ui:SymbolIcon Chat24}"
                     lui:Rail.Note="定時循環">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,16"
                            Padding="12,10"
                            Background="{StaticResource Surface.Raised}"
                            BorderBrush="{StaticResource Line.Subtle}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center"
                                      Margin="0,0,20,0"
                                      Content="依序循環喊話"
                                      IsChecked="{Binding ShoutEnabled, Mode=TwoWay}" />

                            <TextBlock Text="間隔"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" />

                            <ui:NumberBox VerticalAlignment="Center"
                                          Minimum="1"
                                          Maximum="86400"
                                          MaxDecimalPlaces="0"
                                          ClearButtonEnabled="False"
                                          ValidationMode="InvalidInputOverwritten"
                                          Value="{Binding ShoutIntervalSeconds, Mode=TwoWay}" />

                            <TextBlock Text="秒"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <lui:Section Grid.Row="1"
                                 Header="要喊的內容"
                                 Note="一輪一句,由上往下,喊完回到第一句。">
                        <DockPanel>
                            <!-- The one row that adds something, above the list it adds
                                 to. -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox Grid.Column="0"
                                            Margin="0,0,8,0"
                                            PlaceholderText="打一句話,按新增"
                                            Text="{Binding Shout.Candidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ui:Button Grid.Column="1"
                                           Width="96"
                                           Appearance="Primary"
                                           HorizontalContentAlignment="Center"
                                           Content="新增"
                                           Command="{Binding Shout.AddCommand}" />
                            </Grid>

                            <!-- A strip under the list rather than a column beside it: the
                                 list wants the width, and three buttons in a 120-pixel
                                 column left a gap down the whole page. -->
                            <StackPanel DockPanel.Dock="Bottom"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <ui:Button Content="移除"
                                           Appearance="Secondary"
                                           Width="88"
                                           Margin="0,0,8,0"
                                           HorizontalContentAlignment="Center"
                                           Command="{Binding Shout.RemoveCommand}" />
                                <ui:Button Content="上移"
                                           Appearance="Secondary"
                                           Width="76"
                                           Margin="0,0,8,0"
                                           HorizontalContentAlignment="Center"
                                           Command="{Binding Shout.MoveUpCommand}" />
                                <ui:Button Content="下移"
                                           Appearance="Secondary"
                                           Width="76"
                                           HorizontalContentAlignment="Center"
                                           Command="{Binding Shout.MoveDownCommand}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Shout.Items}"
                                     SelectedItem="{Binding Shout.Selected, Mode=TwoWay}" />
                        </DockPanel>
                    </lui:Section>
                </Grid>
            </TabItem>

            <TabItem Header="其他"
                     lui:Rail.Icon="{ui:SymbolIcon Wrench24}"
                     lui:Rail.Note="客戶端調整">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel DataContext="{Binding Misc}">
                        <lui:Section Header="畫面" Note="直接改動執行中的客戶端,勾掉就立刻改回來。">
                            <StackPanel>
                                <CheckBox Content="全白天"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding AllDay, Mode=TwoWay}" />

                                <CheckBox Content="海底抽水"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding UnderwaterPump, Mode=TwoWay}" />

                                <CheckBox Content="降低 CPU 使用率"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding LowCpu, Mode=TwoWay}" />

                                <CheckBox Content="怪物等級色彩"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding MonsterLevelColour, Mode=TwoWay}" />

                                <CheckBox Content="顯示遊戲時鐘"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding ShowClock, Mode=TwoWay}" />

                                <CheckBox Content="顯示攻擊傷害"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding ShowAttackDamage, Mode=TwoWay}" />

                                <!-- Indented and disabled together: it decides how the one
                                     above draws, and on its own it decides nothing. -->
                                <CheckBox Content="顯示在腳下(不勾則顯示在頭上)"
                                          Margin="25,0,0,0"
                                          IsEnabled="{Binding ShowAttackDamage}"
                                          IsChecked="{Binding DamageAtFeet, Mode=TwoWay}" />
                            </StackPanel>
                        </lui:Section>

                        <lui:Section Header="提示" Note="撿到東西和進帳時,在畫面上飄一行字。">
                            <StackPanel>
                                <CheckBox Content="撿取道具提示"
                                          Margin="{StaticResource RowSpacing}"
                                          IsChecked="{Binding PickupToast, Mode=TwoWay}" />

                                <CheckBox Content="金幣經驗值提示"
                                          IsChecked="{Binding GainDrift, Mode=TwoWay}" />
                            </StackPanel>
                        </lui:Section>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Timers ==================== -->
            <TabItem Header="定時"
                     lui:Rail.Icon="{ui:SymbolIcon Timer24}"
                     lui:Rail.Note="每隔幾秒執行">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <lui:Section Header="定時執行" Note="每一列各自計時,到了就送出那一列的指令。">
                            <StackPanel>
                                <CheckBox Content="啟用定時執行"
                                          Margin="0,0,0,10"
                                          IsChecked="{Binding TimersEnabled, Mode=TwoWay}" />

                                <ItemsControl ItemsSource="{Binding Timers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type helper:TimerRowViewModel}">
                                    <Grid Margin="{StaticResource RowSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                        <TextBlock Grid.Column="1"
                                                      Text="{Binding Label}"
                                                      Style="{StaticResource FieldLabel}" />

                                        <ui:NumberBox Grid.Column="2"
                                                      Margin="0,0,8,0"
                                                      Minimum="1"
                                                      Maximum="86400"
                                                      MaxDecimalPlaces="0"
                                                      ClearButtonEnabled="False"
                                                      ValidationMode="InvalidInputOverwritten"
                                                      Value="{Binding IntervalSeconds, Mode=TwoWay}" />

                                        <ui:TextBox Grid.Column="3"
                                                    Margin="0,0,8,0"
                                                    PlaceholderText="0_加速術/ME"
                                                    Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <ui:Button Grid.Column="4"
                                                   Appearance="Secondary"
                                                   Content="重計"
                                                   ToolTip="從現在起重新計算這一列的間隔"
                                                   Command="{Binding DataContext.RestartTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </lui:Section>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ==================== Footer ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface.Void}"
                BorderBrush="{StaticResource Line.Subtle}"
                BorderThickness="0,1,0,0">
        <Grid Margin="16,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Profile, StringFormat='{}{0} 的設定'}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ItemListPath}"
                              TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Margin="0,0,8,0"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon DocumentEdit24}"
                       Content="編輯道具清單"
                       Command="{Binding EditItemListCommand}" />

            <ui:Button Grid.Column="2"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Content="重新載入"
                       Command="{Binding ReloadItemListCommand}" />
        </Grid>
        </Border>

        <!-- Where the dialogs are drawn. Last child and across every row, so it covers the
             window rather than a corner of it, and it takes no space until something is
             shown in it. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
